# Puerto y dirección del panel (127.0.0.1 = solo este equipo; 0.0.0.0 = toda la red local)
PORT=3900
HOST=127.0.0.1

# Clave maestra para cifrar los ajustes (Odoo, bancos, Telegram).
# Si se deja vacía se genera una automáticamente en data/.secret — NO pierdas ese archivo.
APP_SECRET=

# Protección del panel con usuario y clave (recomendado si HOST=0.0.0.0)
ADMIN_USER=admin
ADMIN_PASSWORD=
